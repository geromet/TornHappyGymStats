<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HappyGymStats.Data\HappyGymStats.Data.csproj" />
    <ProjectReference Include="..\HappyGymStats.Identity\HappyGymStats.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <!-- Npgsql 10.0.3 pulls Relational 10.0.4 transitively, and as the primary
         reference it won this project's version conflict — so AdminPanel ran
         against an older Relational than HappyGymStats.Data was compiled with.
         Pinning it explicitly makes 10.0.11 primary and matches the rest of the
         solution. Bump this whenever Microsoft.EntityFrameworkCore moves. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
