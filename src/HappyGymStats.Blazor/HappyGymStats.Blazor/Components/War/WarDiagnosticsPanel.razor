@if (Warnings.Count > 0)
{
    <MudCard Class="mt-3">
        <MudCardHeader><MudText Typo="Typo.h6">Warnings</MudText></MudCardHeader>
        <MudCardContent>
            <MudList T="string" Dense="true">
                @foreach (var warning in Warnings)
                {
                    <MudListItem T="string">@warning</MudListItem>
                }
            </MudList>
        </MudCardContent>
    </MudCard>
}

@if (Errors.Count > 0 || !string.IsNullOrWhiteSpace(ConnectionError))
{
    <ErrorState Message="The war board encountered a connection problem. Refresh to retry."
                OnRetry="OnRetry"
                Dense="true"
                Class="mt-3" />
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Warnings { get; set; } = Array.Empty<string>();

    [Parameter, EditorRequired]
    public IReadOnlyList<string> Errors { get; set; } = Array.Empty<string>();

    [Parameter]
    public string? ConnectionError { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
