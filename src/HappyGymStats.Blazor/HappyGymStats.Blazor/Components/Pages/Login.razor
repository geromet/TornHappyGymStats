@page "/login"
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Components

<PageTitle>Login · Happy Gym Stats</PageTitle>

<MudPaper Class="pa-6">
    <MudText Typo="Typo.h4" GutterBottom="true">Login</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Sign in to Happy Gym Stats.
    </MudText>

    @if (!string.IsNullOrWhiteSpace(AuthError))
    {
        <ErrorState Message="Sign-in failed. Please try again." Dense="true" />
    }

    <AuthorizeView>
        <Authorized Context="authState">
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4" role="status" aria-live="polite">
                Signed in as @(authState.User.Identity?.Name ?? "signed-in member").
            </MudAlert>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="SignOut">
                Sign out
            </MudButton>
        </Authorized>
        <NotAuthorized>
            <SetupRequiredState Message="You are currently signed out. Sign in to continue to member-only Happy Gym Stats features." />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@(_redirecting ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.Login)"
                       Disabled="@_redirecting"
                       OnClick="SignIn"
                       aria-busy="@_redirecting">
                @(_redirecting ? "Redirecting…" : "Sign in")
            </MudButton>
        </NotAuthorized>
    </AuthorizeView>
</MudPaper>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "authError")]
    public string? AuthError { get; set; }

    private bool _redirecting;
    private string _resolvedReturnUrl = "/";

    protected override void OnParametersSet()
    {
        _resolvedReturnUrl = LocalRedirectPolicy.Normalize(ReturnUrl);
    }

    private void SignIn()
    {
        _redirecting = true;
        var returnUrl = Uri.EscapeDataString(_resolvedReturnUrl);
        Navigation.NavigateTo($"/auth/login?returnUrl={returnUrl}", forceLoad: true);
    }

    private void SignOut()
    {
        Navigation.NavigateTo("/auth/logout?returnUrl=%2F", forceLoad: true);
    }
}
