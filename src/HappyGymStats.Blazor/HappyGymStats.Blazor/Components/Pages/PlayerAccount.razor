@page "/player-account"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims

<PageTitle>Player Account · Happy Gym Stats</PageTitle>

<MudPaper Class="pa-6">
    <MudText Typo="Typo.h4" GutterBottom="true">Player account</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Confirm which Happy Gym Stats account is currently signed in.
    </MudText>

    <AuthorizeView>
        <Authorized Context="authState">
            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h6">Signed-in account</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudSimpleTable Dense="true" Hover="true">
                        <tbody>
                            <tr>
                                <td><strong>Account</strong></td>
                                <td>@GetDisplayName(authState.User)</td>
                            </tr>
                            @if (GetEmail(authState.User) is { } email)
                            {
                                <tr>
                                    <td><strong>Email</strong></td>
                                    <td>@email</td>
                                </tr>
                            }
                            <tr>
                                <td><strong>Session</strong></td>
                                <td>Signed in</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>

                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
                        Technical sign-in diagnostics are intentionally kept out of member-facing pages.
                    </MudAlert>
                </MudCardContent>
            </MudCard>
        </Authorized>
        <NotAuthorized>
            <MudAlert Severity="Severity.Warning">You must be signed in to view player account details.</MudAlert>
        </NotAuthorized>
    </AuthorizeView>
</MudPaper>

@code {
    private static string GetDisplayName(ClaimsPrincipal user)
        => user.Identity?.Name
            ?? FindFirst(user, "preferred_username")
            ?? "Signed-in member";

    private static string? GetEmail(ClaimsPrincipal user)
        => FindFirst(user, ClaimTypes.Email) ?? FindFirst(user, "email");

    private static string? FindFirst(ClaimsPrincipal user, string claimType)
        => user.Claims.FirstOrDefault(c => string.Equals(c.Type, claimType, StringComparison.Ordinal))?.Value;
}
