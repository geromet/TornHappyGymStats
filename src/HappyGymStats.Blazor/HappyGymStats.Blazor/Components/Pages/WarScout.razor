@page "/war/scout/{FactionId:long}"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using HappyGymStats.Core.Models
@inject WarScoutService ScoutService

<PageTitle>Scout faction @FactionId · Happy Gym Stats</PageTitle>

<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <div>
            <MudText Typo="Typo.h4">Pre-war briefing</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Faction @FactionId scored from real ranked-war outcomes, not stat guesses.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@_isLoading">
            Refresh
        </MudButton>
    </MudStack>

    @if (_isLoading && _profile is null && _failure is null)
    {
        <LoadingState Message="Loading scouting report..." Class="mb-0" />
    }

    @if (_failure is { Category: ApiFailureCategory.NotFound })
    {
        <EmptyState Message="No history yet. No captured ranked-war history exists yet for this faction. Backfill may still be in progress." Class="mb-0" />
    }
    else if (_failure is not null)
    {
        <ErrorState Message="@($"Scouting report unavailable. {_failure.SafeMessage}")" Dense="true" Class="mb-0" />
    }

    @if (_profile is { } profile)
    {
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <MudText Typo="Typo.overline">@profile.FactionName</MudText>
                        <Figure Label="Wars observed"
                                Value="@profile.TotalWarsObserved.ToString()"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.TotalWarsObserved)"
                                ValueTypo="Typo.h5" />
                        <Figure Label="Observed window"
                                Value="@FormatDateRange(profile.EarliestWarStartedAtUtc, profile.LatestWarStartedAtUtc)"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.ObservedDateRange)"
                                ValueTypo="Typo.body2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <Figure Label="Active members"
                                Value="@profile.ActiveMemberCount.ToString()"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.ActiveMemberCount)"
                                Note="Consistent + occasional swingers"
                                ValueTypo="Typo.h5" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <Figure Label="Idle-prone members"
                                Value="@profile.IdleProneMemberCount.ToString()"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.IdleProneMemberCount)"
                                Note="Idle in half or more of their wars"
                                ValueTypo="Typo.h5" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <Figure Label="Roster size"
                                Value="@profile.TypicalRosterSize.ToString()"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.TypicalRosterSize)"
                                Note="Typical fielded per war"
                                ValueTypo="Typo.h5" />
                        <Figure Label="Members seen"
                                Value="@profile.Members.Count.ToString()"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.MembersSeen)"
                                ValueTypo="Typo.body2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <Figure Label="Record"
                                Value="@(profile.WarsWithKnownOutcome > 0 ? FormatPercent(profile.WinRate) : "—")"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.WinRate)"
                                Note="Win rate"
                                ValueTypo="Typo.h5" />
                        <Figure Label="Outcome sample"
                                Value="@($"{profile.WarsWithKnownOutcome} of {profile.TotalWarsObserved} wars")"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.OutcomeSample)"
                                ValueTypo="Typo.body2" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <Figure Label="Typical target score"
                                Value="@(profile.TypicalTargetScore > 0 ? profile.TypicalTargetScore.ToString("N0") : "—")"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.TypicalTargetScore)"
                                Note="Their median final score — what you must beat"
                                ValueTypo="Typo.h5" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <Figure Label="Score pace"
                                Value="@(profile.PointsPerHour is { } pph ? $"{pph:N0}/h" : "—")"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.PointsPerHour)"
                                Note="Median points per hour of completed wars"
                                ValueTypo="Typo.h5" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCard Class="war-summary-card">
                    <MudCardContent>
                        <Figure Label="Scoring concentration"
                                Value="@($"{FormatPercent(profile.Top5ScoreShare)} top 5")"
                                Kind="@WarScoutProvenance.For(WarScoutMetric.Top5ScoreShare)"
                                Note="@($"{FormatPercent(profile.Top10ScoreShare)} from the top 10 — high share favours lockdown")"
                                ValueTypo="Typo.h5" />
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Per-member war history</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Ranked by lump-adjusted score per attack. Chain-milestone lump wars are detected against the faction baseline, then their bonus is removed so a single well-timed crossing hit doesn't inflate the rating.
                    </MudText>
                    <Figure Label="Faction baseline score/attack"
                            Value="@profile.MedianScorePerAttack.ToString()"
                            Kind="@WarScoutProvenance.For(WarScoutMetric.MedianScorePerAttack)"
                            Note="Historical median used for lump detection"
                            ValueTypo="Typo.body2" />
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTable Dense="true" Hover="true" Breakpoint="Breakpoint.Md" Items="@profile.Members">
                    <HeaderContent>
                        <MudTh>Member</MudTh>
                        <MudTh>Threat tier</MudTh>
                        <MudTh>Wars</MudTh>
                        <MudTh>Participation</MudTh>
                        <MudTh>Lump-adjusted score/attack</MudTh>
                        <MudTh>Raw score/attack</MudTh>
                        <MudTh>Lump-adjusted score/war</MudTh>
                        <MudTh>Score range</MudTh>
                        <MudTh>Idle rate</MudTh>
                        <MudTh>Last seen</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Member">
                            <MudText Typo="Typo.body2">@context.MemberName</MudText>
                            @if (context.LumpWarCount > 0)
                            {
                                <Figure Label="Detected lump wars"
                                        Value="@($"{context.LumpWarCount} lump")"
                                        Kind="@WarScoutProvenance.For(WarScoutMetric.LumpWarCount)"
                                        Compact="true"
                                        ValueTypo="Typo.caption" />
                            }
                        </MudTd>
                        <MudTd DataLabel="Threat tier">
                            <Figure Label="Threat tier"
                                    Value="@FormatTier(context.ThreatTier)"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.ThreatTier)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Wars">
                            <Figure Label="Wars participated"
                                    Value="@context.WarsParticipated.ToString()"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.WarsParticipated)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Participation">
                            <Figure Label="Participation rate"
                                    Value="@FormatPercent(context.ParticipationRate)"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.ParticipationRate)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Lump-adjusted score/attack">
                            <Figure Label="Lump-adjusted score per attack"
                                    Value="@context.LumpAdjustedScorePerAttack.ToString()"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.LumpAdjustedScorePerAttack)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Raw score/attack">
                            <Figure Label="Raw score per attack"
                                    Value="@context.AverageScorePerAttack.ToString()"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.AverageScorePerAttack)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Lump-adjusted score/war">
                            <Figure Label="Lump-adjusted score per war"
                                    Value="@context.LumpAdjustedScorePerWar.ToString()"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.LumpAdjustedScorePerWar)"
                                    Note="@(context.RawMedianScorePerWar != context.LumpAdjustedScorePerWar ? $"raw median {context.RawMedianScorePerWar}" : null)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Score range">
                            <Figure Label="Observed score range"
                                    Value="@($"{context.MinScoreInAWar} – {context.MaxScoreInAWar}")"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.ScoreRange)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Idle rate">
                            <Figure Label="Idle rate"
                                    Value="@FormatPercent(context.IdleRate)"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.IdleRate)"
                                    Compact="true" />
                        </MudTd>
                        <MudTd DataLabel="Last seen">
                            <Figure Label="Last seen"
                                    Value="@FormatTimestamp(context.LastSeenAtUtc)"
                                    Kind="@WarScoutProvenance.For(WarScoutMetric.LastSeen)"
                                    Compact="true" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    }
</MudStack>

@code {
    [Parameter]
    public long FactionId { get; set; }

    private FactionScoutDto? _profile;
    private ApiFailure? _failure;
    private bool _isLoading;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _profile = null;
        _failure = null;
        StateHasChanged();

        try
        {
            var (profile, failure) = await ScoutService.GetProfileAsync(FactionId);
            _profile = profile;
            _failure = failure;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static string FormatPercent(decimal value) => $"{value:P0}";

    private static string FormatTimestamp(DateTimeOffset? value) => value?.ToLocalTime().ToString("yyyy-MM-dd") ?? "unknown";

    private static string FormatDateRange(DateTimeOffset? earliest, DateTimeOffset? latest)
    {
        if (earliest is null || latest is null)
        {
            return "No dated wars";
        }

        return $"{earliest.Value.ToLocalTime():yyyy-MM-dd} to {latest.Value.ToLocalTime():yyyy-MM-dd}";
    }

    private static string FormatTier(string tier) => tier switch
    {
        "ConsistentSwinger" => "Consistent swinger",
        "OccasionalSwinger" => "Occasional swinger",
        "IdleProne" => "Idle-prone",
        _ => tier
    };
}
