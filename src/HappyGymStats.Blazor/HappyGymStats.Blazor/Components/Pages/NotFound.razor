@page "/not-found"
@layout MainLayout

<PageTitle>Page not found · Happy Gym Stats</PageTitle>

<MudStack Spacing="3" Class="mx-auto mt-6" Style="max-width:600px;">
    <h1 class="mud-typography mud-typography-h4">Page not found</h1>

    <EmptyState Message="That Happy Gym Stats page does not exist or may have moved." Dense="false">
        <Actions>
            <MudStack Row="true" Spacing="2" Class="flex-wrap">
                <MudButton Href="/"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Home">
                    Go to home
                </MudButton>
                <MudButton Href="/war"
                           Variant="Variant.Outlined"
                           Color="Color.Primary">
                    Open War
                </MudButton>
            </MudStack>
        </Actions>
    </EmptyState>
</MudStack>
