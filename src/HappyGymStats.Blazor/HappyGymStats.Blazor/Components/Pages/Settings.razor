@page "/settings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Preferences · Happy Gym Stats</PageTitle>

<MudPaper Class="pa-6">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h4">Preferences</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            There are no member preferences to configure yet.
        </MudText>
        <MudText Typo="Typo.body2">
            Torn credentials and connection consent are managed from Account &amp; Connections instead of developer settings.
        </MudText>
        <MudButton Href="/player-account" Variant="Variant.Outlined" Color="Color.Primary">
            Open Account &amp; Connections
        </MudButton>
    </MudStack>
</MudPaper>
