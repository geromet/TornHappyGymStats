@page "/"
@rendermode InteractiveServer

<PageTitle>Happy Gym Stats</PageTitle>

<MudPaper Class="pa-6 pa-md-10 mb-6" Outlined="true">
    <MudStack Spacing="3">
        <MudText Typo="Typo.overline" Color="Color.Primary">Torn training + war intelligence</MudText>
        <MudText Typo="Typo.h3">Train smarter. Scout faster. Make war decisions with better context.</MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary">
            Happy Gym Stats keeps training history, scouting context, and war tools in one focused workspace without making raw data plumbing the product.
        </MudText>

        <AuthorizeView>
            <Authorized>
                <MudStack Row="true" Spacing="2" Class="flex-wrap">
                    <MudButton Href="/my-stats"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Timeline">
                        My training
                    </MudButton>
                    <MudButton Href="/war/scout"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Visibility">
                        Scout opponent
                    </MudButton>
                    <MudButton Href="/war"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.GpsFixed">
                        Live War
                    </MudButton>
                </MudStack>
            </Authorized>
            <NotAuthorized>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudButton Href="/auth/login?returnUrl=%2F"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Login">
                        Sign in
                    </MudButton>
                    <MudLink Href="/privacy">How we handle your data</MudLink>
                </MudStack>
            </NotAuthorized>
        </AuthorizeView>
    </MudStack>
</MudPaper>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h5" Class="mb-3">Your workspace</MudText>
        <MudGrid Class="mb-5">
            <MudItem xs="12" md="4">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudStack Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.GpsFixed" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">War ops</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Open Live War for current operational context, or jump straight into opponent scouting when you already know the target.
                            </MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Href="/war" Variant="Variant.Text" Size="Size.Small">Live War</MudButton>
                                <MudButton Href="/war/scout" Variant="Variant.Text" Size="Size.Small">Scout</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudStack Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">My training</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Review your training history and supported observational views without mixing personal progress with the public research dataset.
                            </MudText>
                            <MudButton Href="/my-stats" Variant="Variant.Text" Size="Size.Small">Open my training</MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudStack Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">Account &amp; connections</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Keep identity and connection setup in one place instead of repeatedly entering technical credentials on product pages.
                            </MudText>
                            <MudButton Href="/player-account" Variant="Variant.Text" Size="Size.Small">Manage connections</MudButton>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Looking for the research view? The public 3D gym point cloud now lives in <MudLink Href="/gym-explorer">Gym Explorer</MudLink>, so it no longer dominates the landing page.
        </MudAlert>
    </Authorized>
    <NotAuthorized>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Training context</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Turn your own gym history into useful, evidence-backed views after signing in.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">War tools</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Keep scouting and faction decisions close to the operational context that makes them useful.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Style="height: 100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" GutterBottom="true">Research explorer</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Explore the public gym point cloud when you want the raw research surface, without loading it on every visit.
                        </MudText>
                        <MudButton Href="/gym-explorer" Variant="Variant.Text" Size="Size.Small" Class="mt-2">Open Gym Explorer</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </NotAuthorized>
</AuthorizeView>
