@page "/war"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using HappyGymStats.Blazor.Components.War
@implements IDisposable
@inject WarBoardService WarBoard

<PageTitle>War board · Happy Gym Stats</PageTitle>

<MudStack Spacing="3">
    <WarBoardHeader IsLoading="@WarBoard.IsLoading" OnRefresh="RefreshAsync" />

    <WarBoardStateBanners IsInitialLoading="@(WarBoard.IsLoading && WarBoard.CurrentState is null && WarBoard.CurrentFailure is null)"
                          HasFailure="@(WarBoard.CurrentFailure is not null)"
                          HasStaleData="@WarBoard.HasStaleData"
                          HasNoActiveWar="@WarBoard.HasNoActiveWar"
                          OnRetry="RefreshAsync" />

    @if (!WarBoard.HasNoActiveWar && WarBoard.CurrentState is { } state)
    {
        <WarBoardSummary State="state"
                         ConnectionState="@WarBoard.ConnectionState"
                         DataSource="@WarBoard.DataSource" />

        <MudGrid>
            <MudItem xs="12" lg="8">
                <WarFactionList Factions="state.Factions" />
            </MudItem>

            <MudItem xs="12" lg="4">
                <WarHoleAlerts Holes="state.Holes" />
                <WarDiagnosticsPanel Warnings="state.Warnings"
                                     Errors="state.Errors"
                                     ConnectionError="@WarBoard.ConnectionError"
                                     OnRetry="RefreshAsync" />
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    protected override async Task OnInitializedAsync()
    {
        WarBoard.StateChanged += HandleBoardStateChanged;
        await WarBoard.InitializeAsync();
    }

    public void Dispose()
    {
        WarBoard.StateChanged -= HandleBoardStateChanged;
    }

    private Task RefreshAsync() => WarBoard.RefreshAsync();

    private void HandleBoardStateChanged() => InvokeAsync(StateHasChanged);
}
