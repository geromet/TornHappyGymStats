@page "/chain-calculator"
@rendermode InteractiveServer
@using HappyGymStats.Core.War
@inject IJSRuntime JS
@inject ILogger<ChainCalculator> Logger

<PageTitle>Chain planner · Happy Gym Stats</PageTitle>

<div class="chain-planner-page">
    <MudText Typo="Typo.h4" Class="mb-1">Chain planner</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Turn the hits you actually have into a practical chain plan, then compare the closest alternatives.
    </MudText>

    <MudGrid>
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Class="pa-4 mb-4 planner-inputs" Elevation="2">
                <MudText Typo="Typo.subtitle1" Class="mb-3">Plan your hits</MudText>
                <MudNumericField T="int" @bind-Value="_budget" Label="Hits available" Min="1" Max="200000" Class="mb-2" />

                <MudText Typo="Typo.caption" Color="Color.Secondary">Quick budgets</MudText>
                <div class="budget-presets mb-3" aria-label="Hit budget presets">
                    @foreach (var preset in BudgetPresets)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ApplyBudgetPreset(preset))"
                                   aria-label="@($"Use {preset:N0} hits")">
                            @preset.ToString("N0")
                        </MudButton>
                    }
                </div>

                <MudNumericField T="double" @bind-Value="_baseRespect" Label="Base respect" Min="0.1" Class="mb-2" />
                <MudTextField Value="@GoalMaxRespect" Label="Goal" ReadOnly="true" Class="mb-3" />

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="Search">
                    Update plan
                </MudButton>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    The current engine ranks plans by total respect. Formula controls stay out of the primary workflow.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8" lg="9">
            <MudTabs ActivePanelIndex="_activeTab" ActivePanelIndexChanged="OnTabChangedAsync" Rounded="true" ApplyEffectsToContainer="true">
                <MudTabPanel Text="Plan">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">@_status</MudText>

                    @if (_splits.Count == 0)
                    {
                        <MudPaper Class="pa-5 mb-4 no-plan-card" Elevation="1" data-testid="chain-no-plan">
                            <MudText Typo="Typo.h6" Class="mb-1">No valid plan</MudText>
                            <MudText Typo="Typo.body2">
                                Nothing fits the current hit budget and constraints. Loosen the constraints below or increase the budget.
                            </MudText>
                        </MudPaper>
                    }
                    else
                    {
                        var best = _splits[0];

                        <MudPaper Class="pa-5 mb-4 recommendation-card" Elevation="3" data-testid="chain-recommendation">
                            <MudText Typo="Typo.overline" Color="Color.Primary">Recommended plan</MudText>
                            <MudText Typo="Typo.h4" Class="mb-2">@best.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                Highest total respect under the current budget and constraints.
                            </MudText>

                            <div class="plan-stat-grid mb-4">
                                <div class="plan-stat">
                                    <span class="plan-stat-label">Hits used</span>
                                    <strong>@best.Hits.ToString("N0")</strong>
                                </div>
                                <div class="plan-stat">
                                    <span class="plan-stat-label">Chains</span>
                                    <strong>@best.Legs.Length</strong>
                                </div>
                                <div class="plan-stat">
                                    <span class="plan-stat-label">Total respect</span>
                                    <strong>@best.Respect.ToString("N0")</strong>
                                </div>
                                <div class="plan-stat">
                                    <span class="plan-stat-label">Respect / hit</span>
                                    <strong>@best.PerHit.ToString("N3")</strong>
                                </div>
                            </div>

                            @if (BestTieCount > 1)
                            {
                                <MudText Typo="Typo.body2" Class="mb-3 tie-note">
                                    @BestTieCount plans tie for the top result. The first is shown as the default; tied choices remain visible below.
                                </MudText>
                            }

                            <div class="comparison-actions">
                                <MudButton Variant="Variant.Outlined" OnClick="@(() => SetSelectionAsync(best, isA: true))">
                                    Use as Plan A
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="@(() => SetSelectionAsync(best, isA: false))">
                                    Use as Plan B
                                </MudButton>
                            </div>
                        </MudPaper>

                        <MudText Typo="Typo.h6" Class="mb-2">Alternatives</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            The closest practical options, with the tradeoff from the recommended plan called out directly.
                        </MudText>

                        @if (_splits.Count == 1)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                No distinct alternatives fit the current constraints.
                            </MudText>
                        }
                        else
                        {
                            <div class="alternative-list mb-4">
                                @foreach (var split in AlternativePlans)
                                {
                                    <MudPaper Class="pa-3 alternative-card" Elevation="1">
                                        <div class="alternative-copy">
                                            <MudText Typo="Typo.subtitle1">#@split.Rank · @split.Name</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@DescribeTradeoff(split)</MudText>
                                        </div>
                                        <div class="comparison-actions compact-actions">
                                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SetSelectionAsync(split, isA: true))"
                                                       aria-label="@($"Use {split.Name} as Plan A")">
                                                Use as Plan A
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SetSelectionAsync(split, isA: false))"
                                                       aria-label="@($"Use {split.Name} as Plan B")">
                                                Use as Plan B
                                            </MudButton>
                                        </div>
                                    </MudPaper>
                                }
                            </div>
                        }

                        <MudButton Variant="Variant.Text" OnClick="ToggleShowAll" Class="mb-3">
                            @(_showAll ? "Hide all combinations" : $"Show all {_splits.Count:N0} combinations")
                        </MudButton>

                        @if (_showAll)
                        {
                            <div class="all-combinations" data-testid="chain-all-combinations">
                                <MudTable Items="_splits" Hover="true" Dense="true" Bordered="true" RowStyleFunc="RowStyleFunc"
                                          Striped="true" FixedHeader="true" Height="520px">
                                    <HeaderContent>
                                        <MudTh>#</MudTh>
                                        <MudTh>Combination</MudTh>
                                        <MudTh>Chains</MudTh>
                                        <MudTh>Hits</MudTh>
                                        <MudTh>Unused</MudTh>
                                        <MudTh>Respect</MudTh>
                                        <MudTh>Respect / hit</MudTh>
                                        <MudTh>vs best</MudTh>
                                        <MudTh>Compare</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="split">
                                        <MudTd DataLabel="#">@split.Rank</MudTd>
                                        <MudTd DataLabel="Combination">@split.Name</MudTd>
                                        <MudTd DataLabel="Chains">@split.Legs.Length</MudTd>
                                        <MudTd DataLabel="Hits">@split.Hits.ToString("N0")</MudTd>
                                        <MudTd DataLabel="Unused">@((_budget - split.Hits).ToString("N0"))</MudTd>
                                        <MudTd DataLabel="Respect">@split.Respect.ToString("N0")</MudTd>
                                        <MudTd DataLabel="Respect / hit">@split.PerHit.ToString("N3")</MudTd>
                                        <MudTd DataLabel="vs best">@VsBest(split)</MudTd>
                                        <MudTd DataLabel="Compare">
                                            <div class="table-compare-actions">
                                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SetSelectionAsync(split, isA: true))">Plan A</MudButton>
                                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => SetSelectionAsync(split, isA: false))">Plan B</MudButton>
                                            </div>
                                        </MudTd>
                                    </RowTemplate>
                                    <PagerContent>
                                        <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
                                    </PagerContent>
                                </MudTable>
                            </div>
                        }
                    }

                    <div class="planner-secondary mt-5">
                        <details class="planner-details">
                            <summary>Planning constraints</summary>
                            <div class="planner-details-body">
                                <MudNumericField T="int" @bind-Value="_maxLegs" Label="Max chains" Min="1" Max="12" Class="mb-2" />
                                <MudNumericField T="int" @bind-Value="_minLeg" Label="Min chain length" Min="1" Class="mb-2" />
                                <MudNumericField T="int?" @bind-Value="_maxLeg" Label="Max chain length (optional)" Min="1" Class="mb-2" />
                                <MudCheckBox T="bool" @bind-Value="_spendAll" Label="Spend every hit" Class="mb-2" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                    Raise the minimum to hide combinations like 990 + 10 that nobody would intentionally plan.
                                </MudText>
                                <MudButton Variant="Variant.Outlined" OnClick="Search">Apply constraints</MudButton>
                            </div>
                        </details>

                        <details class="planner-details" data-testid="advanced-model-settings">
                            <summary>Advanced model settings</summary>
                            <div class="planner-details-body">
                                <MudNumericField T="double" @bind-Value="_a" Label="log10 coefficient (a)" Class="mb-2" />
                                <MudNumericField T="double" @bind-Value="_b" Label="constant (b)" Class="mb-2" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                    respect per hit = base × (a·log10(hit) + b). Verified defaults: a = @ChainEngine.DefaultA, b = @ChainEngine.DefaultB.
                                </MudText>
                                <div class="comparison-actions">
                                    <MudButton Variant="Variant.Outlined" OnClick="Search">Apply model settings</MudButton>
                                    <MudButton Variant="Variant.Text" OnClick="ResetModelDefaults">Reset to verified defaults</MudButton>
                                </div>
                            </div>
                        </details>
                    </div>
                </MudTabPanel>

                <MudTabPanel Text="Compare">
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Choose Plan A and Plan B from the recommendation, alternative cards, or expanded combinations list.
                    </MudText>
                    <MudGrid Class="mb-3">
                        <MudItem xs="12" sm="6">
                            <MudPaper Class="pa-3 comparison-plan" Elevation="1">
                                <MudText Typo="Typo.overline">Plan A</MudText>
                                <MudText Typo="Typo.h6">@(_selectedA?.Name ?? "Not selected")</MudText>
                                @if (_selectedA is not null)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@DescribePlan(_selectedA)</MudText>
                                }
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudPaper Class="pa-3 comparison-plan" Elevation="1">
                                <MudText Typo="Typo.overline">Plan B</MudText>
                                <MudText Typo="Typo.h6">@(_selectedB?.Name ?? "Not selected")</MudText>
                                @if (_selectedB is not null)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@DescribePlan(_selectedB)</MudText>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="3">
                        <MudCheckBox T="bool" Value="_showDiff" Label="Show difference (Plan B − Plan A)" ValueChanged="OnDiffToggledAsync" />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SwapSelectionAsync">Swap Plan A / Plan B</MudButton>
                    </MudStack>
                    <div id="chain-compare-chart" class="chain-chart"></div>
                    <MudText Typo="Typo.body2" Class="mt-3" Style="white-space: pre-line;">@CompareSummary()</MudText>
                </MudTabPanel>

                <MudTabPanel Text="Curve">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="3">
                        <MudSelect T="string" Value="_curveMode" Label="Show" ValueChanged="OnCurveModeChangedAsync" Style="max-width:220px;">
                            <MudSelectItem Value="@("Respect per hit")">Respect per hit</MudSelectItem>
                            <MudSelectItem Value="@("Total respect")">Total respect</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                    <div id="chain-curve-chart" class="chain-chart"></div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        One unbroken chain, for reference. The sharp rises are milestone bonuses (10, 25, 50, 100 hits, …) —
                        a lump sum of respect that gets added the instant the chain reaches that length. Because the bonus
                        is a one-time payment, "respect per hit" spikes right at the milestone and then decays back down
                        as later hits dilute it across a longer chain. The dashed line strips the bonuses out entirely, so
                        you can see the smooth, bonus-free growth underneath.
                    </MudText>
                </MudTabPanel>

                <MudTabPanel Text="Milestones">
                    <MudTable Items="@BuildBonusRows()" Hover="true" Dense="true" Bordered="true">
                        <HeaderContent>
                            <MudTh>Milestone</MudTh>
                            <MudTh>Bonus</MudTh>
                            <MudTh>Cumulative</MudTh>
                            <MudTh>Chain timer</MudTh>
                            <MudTh>Chain respect here</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="row">
                            <MudTd DataLabel="Milestone">@row.Milestone.ToString("N0")</MudTd>
                            <MudTd DataLabel="Bonus">@row.Bonus.ToString("N0")</MudTd>
                            <MudTd DataLabel="Cumulative">@row.Cumulative.ToString("N0")</MudTd>
                            <MudTd DataLabel="Chain timer">@row.Timer</MudTd>
                            <MudTd DataLabel="Chain respect here">@row.Respect.ToString("N0")</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                        The timer column is reference only; it does not enter any calculation.
                    </MudText>
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
</div>

@code {
    private const string GoalMaxRespect = "Maximize total respect";
    private static readonly int[] BudgetPresets = [250, 500, 1_000, 2_500, 5_000];

    private double _a = ChainEngine.DefaultA;
    private double _b = ChainEngine.DefaultB;
    private double _baseRespect = ChainEngine.DefaultBase;
    private int _budget = 1000;
    private int _maxLegs = 6;
    private int _minLeg = 10;
    private int? _maxLeg;
    private bool _spendAll = true;

    private ChainEngine _engine = new();
    private List<ChainSplit> _splits = new();
    private ChainSplit? _selectedA;
    private ChainSplit? _selectedB;
    private bool _showAll;
    private bool _showDiff;
    private string _curveMode = "Respect per hit";
    private string _status = "Ready.";

    private int _activeTab;
    private bool _compareChartDirty;
    private bool _curveChartDirty = true;

    private IEnumerable<ChainSplit> AlternativePlans => _splits.Skip(1).Take(4);

    private int BestTieCount
    {
        get
        {
            if (_splits.Count == 0) return 0;
            var best = _splits[0].Respect;
            var tolerance = Math.Max(0.0001, Math.Abs(best) * 0.000000001);
            return _splits.TakeWhile(split => Math.Abs(split.Respect - best) <= tolerance).Count();
        }
    }

    protected override void OnInitialized() => Search();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_activeTab == 1 && _compareChartDirty)
        {
            _compareChartDirty = false;
            await DrawCompareChartAsync();
        }
        else if (_activeTab == 2 && _curveChartDirty)
        {
            _curveChartDirty = false;
            await DrawCurveChartAsync();
        }
    }

    private void ApplyBudgetPreset(int budget)
    {
        _budget = budget;
        Search();
    }

    private void ResetModelDefaults()
    {
        _a = ChainEngine.DefaultA;
        _b = ChainEngine.DefaultB;
        Search();
    }

    private void ToggleShowAll() => _showAll = !_showAll;

    private void Search()
    {
        if (_budget < 1 || _maxLegs < 1)
        {
            _splits = [];
            _selectedA = null;
            _selectedB = null;
            _status = "Hits available and max chains must both be at least 1.";
            return;
        }
        if (_maxLegs > 12)
        {
            _maxLegs = 12;
        }

        _engine = new ChainEngine(_a, _b);
        _splits = ChainEngine.EnumerateSplits(_engine, _budget, _baseRespect, _maxLegs, _spendAll, _maxLeg, Math.Max(1, _minLeg));
        _selectedA = _splits.Count > 0 ? _splits[0] : null;
        _selectedB = _splits.Count > 1 ? _splits[1] : null;
        _status = _splits.Count == 0
            ? "No combination fits the current budget and constraints."
            : $"{_splits.Count:N0} valid combinations · {_budget:N0} hits available · base respect {_baseRespect:g}.";
        _compareChartDirty = true;
        _curveChartDirty = true;
    }

    private async Task OnTabChangedAsync(int index)
    {
        _activeTab = index;
        if (index == 1) await DrawCompareChartAsync();
        else if (index == 2) await DrawCurveChartAsync();
    }

    private async Task SetSelectionAsync(ChainSplit split, bool isA)
    {
        if (isA) _selectedA = split; else _selectedB = split;
        if (_activeTab == 1) await DrawCompareChartAsync();
        else _compareChartDirty = true;
    }

    private async Task SwapSelectionAsync()
    {
        (_selectedA, _selectedB) = (_selectedB, _selectedA);
        if (_activeTab == 1) await DrawCompareChartAsync();
    }

    private async Task OnDiffToggledAsync(bool value)
    {
        _showDiff = value;
        await DrawCompareChartAsync();
    }

    private async Task OnCurveModeChangedAsync(string value)
    {
        _curveMode = value;
        await DrawCurveChartAsync();
    }

    private string VsBest(ChainSplit split)
    {
        if (_splits.Count == 0) return "";
        var top = _splits[0];
        if (ReferenceEquals(split, top)) return "best";
        var rel = top.Respect > 0 ? split.Respect / top.Respect - 1 : 0;
        return rel.ToString("+0.00%;-0.00%;0%");
    }

    private string DescribeTradeoff(ChainSplit split)
    {
        if (_splits.Count == 0) return DescribePlan(split);

        var best = _splits[0];
        var respectGap = best.Respect > 0 ? Math.Max(0, (best.Respect - split.Respect) / best.Respect) : 0;
        var comparison = respectGap <= 0.000000001 ? "ties the top respect" : $"{respectGap:P1} less respect";
        var unused = Math.Max(0, _budget - split.Hits);
        var budgetUse = unused == 0 ? "uses the full budget" : $"leaves {unused:N0} hits";
        var chainLabel = split.Legs.Length == 1 ? "1 chain" : $"{split.Legs.Length} chains";
        return $"{comparison} · {chainLabel} · {budgetUse} · {split.Respect:N0} respect";
    }

    private static string DescribePlan(ChainSplit split)
    {
        var chainLabel = split.Legs.Length == 1 ? "1 chain" : $"{split.Legs.Length} chains";
        return $"{split.Hits:N0} hits · {chainLabel} · {split.Respect:N0} respect · {split.PerHit:N3} respect/hit";
    }

    private string CompareSummary()
    {
        if (_selectedA == null || _selectedB == null)
            return "Choose two plans from the Plan view to compare them.";

        var a = _selectedA;
        var b = _selectedB;
        var diff = b.Respect - a.Respect;
        var pct = a.Respect > 0 ? diff / a.Respect : 0;
        var lead = b.Respect > a.Respect ? "Plan B" : (a.Respect > b.Respect ? "Plan A" : "tie");

        return $"Plan A: {a.Name}  hits={a.Hits:N0}  respect={a.Respect:N0}\n" +
               $"Plan B: {b.Name}  hits={b.Hits:N0}  respect={b.Respect:N0}\n" +
               $"B − A: {diff:+#,0;-#,0;0}  ({pct:+0.0%;-0.0%;0%})\n" +
               $"Ahead: {lead}";
    }

    private async Task DrawCompareChartAsync()
    {
        try
        {
            var traces = new List<object>();
            List<double>? curveA = _selectedA != null ? _engine.CumulativeCurve(_selectedA.Legs, _baseRespect) : null;
            List<double>? curveB = _selectedB != null ? _engine.CumulativeCurve(_selectedB.Legs, _baseRespect) : null;

            if (_showDiff && curveA != null && curveB != null)
            {
                var span = Math.Max(curveA.Count, curveB.Count);
                var full = new double[span];
                for (var i = 0; i < span; i++)
                {
                    var va = curveA[Math.Min(i, curveA.Count - 1)];
                    var vb = curveB[Math.Min(i, curveB.Count - 1)];
                    full[i] = vb - va;
                }
                var (dx, dy) = Downsample(full);
                traces.Add(BuildLine(dx, dy, "Plan B − Plan A", "#16a34a"));
            }
            else
            {
                if (curveA != null)
                {
                    var (ax, ay) = Downsample(curveA);
                    traces.Add(BuildLine(ax, ay, "Plan A", "#2563eb"));
                }
                if (curveB != null)
                {
                    var (bx, by) = Downsample(curveB);
                    traces.Add(BuildLine(bx, by, "Plan B", "#ea580c"));
                }
            }

            await JS.InvokeVoidAsync("plotlyInterop.render", "chain-compare-chart", traces,
                BuildChartLayout("Hits", "Cumulative respect", xLog: false));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to draw chain compare chart");
        }
    }

    private async Task DrawCurveChartAsync()
    {
        try
        {
            var max = Math.Clamp(Math.Max(_budget * 2, 10_000), 100, 200_000);
            var points = BuildCurvePoints(max);
            var xs = new double[points.Count];
            var ys = new double[points.Count];
            var ysNoBonus = new double[points.Count];
            for (var i = 0; i < points.Count; i++)
            {
                var n = points[i];
                var respect = _engine.ChainRespect(n, _baseRespect);
                var respectNoBonus = _baseRespect * _engine.SigmaMult(n);
                xs[i] = n;
                ys[i] = _curveMode == "Respect per hit" ? respect / n : respect;
                ysNoBonus[i] = _curveMode == "Respect per hit" ? respectNoBonus / n : respectNoBonus;
            }

            var trace = BuildLine(xs, ys, "With milestone bonuses", "#2563eb");
            var traceNoBonus = BuildDashedLine(xs, ysNoBonus, "Without milestone bonuses", "#ea580c");
            await JS.InvokeVoidAsync("plotlyInterop.render", "chain-curve-chart", new[] { trace, traceNoBonus },
                BuildChartLayout("Chain length (log scale)", _curveMode, xLog: true));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to draw chain curve chart");
        }
    }

    private static List<int> BuildCurvePoints(int max)
    {
        var points = new List<int>();
        for (var p = 1; p <= Math.Min(100, max); p++) points.Add(p);
        for (var p = 110; p <= Math.Min(1000, max); p += 10) points.Add(p);
        for (var p = 1100; p <= Math.Min(10000, max); p += 100) points.Add(p);
        for (var p = 10500; p <= max; p += 500) points.Add(p);
        return points;
    }

    private static (double[] X, double[] Y) Downsample(IReadOnlyList<double> curve, int maxPoints = 1200)
    {
        var n = curve.Count;
        if (n == 0) return (Array.Empty<double>(), Array.Empty<double>());
        var stride = Math.Max(1, (int)Math.Ceiling(n / (double)maxPoints));
        var xs = new List<double>();
        var ys = new List<double>();
        for (var i = 0; i < n; i += stride)
        {
            xs.Add(i + 1);
            ys.Add(curve[i]);
        }
        if ((int)xs[^1] != n)
        {
            xs.Add(n);
            ys.Add(curve[n - 1]);
        }
        return (xs.ToArray(), ys.ToArray());
    }

    private IEnumerable<BonusRow> BuildBonusRows()
    {
        var running = 0;
        foreach (var (milestone, bonus, timer) in ChainEngine.BonusTable)
        {
            running += bonus;
            yield return new BonusRow(milestone, bonus, running, timer, _engine.ChainRespect(milestone, _baseRespect));
        }
    }

    private string RowStyleFunc(ChainSplit split, int index)
    {
        if (ReferenceEquals(split, _selectedA)) return "background-color: rgba(37,99,235,0.18);";
        if (ReferenceEquals(split, _selectedB)) return "background-color: rgba(234,88,12,0.18);";
        return string.Empty;
    }

    private static object BuildLine(double[] x, double[] y, string name, string color) => new
    {
        type = "scatter",
        mode = "lines",
        name,
        x,
        y,
        line = new { color, width = 2 }
    };

    private static object BuildDashedLine(double[] x, double[] y, string name, string color) => new
    {
        type = "scatter",
        mode = "lines",
        name,
        x,
        y,
        line = new { color, width = 2, dash = "dash" }
    };

    private static object BuildChartLayout(string xTitle, string yTitle, bool xLog) => new
    {
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "rgba(0,0,0,0)",
        font = new { color = "#e8f1ff", family = "Roboto, sans-serif" },
        showlegend = true,
        legend = new { font = new { color = "#e8f1ff" } },
        xaxis = new { title = xTitle, type = xLog ? "log" : "linear", gridcolor = "#243457", zerolinecolor = "#243457" },
        yaxis = new { title = yTitle, gridcolor = "#243457", zerolinecolor = "#243457" },
        margin = new { l = 60, r = 20, t = 20, b = 50 }
    };

    private readonly record struct BonusRow(int Milestone, int Bonus, int Cumulative, string Timer, double Respect);
}
