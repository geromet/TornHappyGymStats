@page "/my-stats"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@inject SurfacesService SurfacesApi
@inject IJSRuntime JS
@inject ILogger<MyStats> Logger

<PageTitle>My Training · Happy Gym Stats</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading your training data…" />
}
else
{
    <MudStack Spacing="3">
        <div>
            <MudText Typo="Typo.h4">My Training</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Review your observed training efficiency and its relationship with happiness and stat size. These charts describe your imported history; they do not prescribe a training strategy.
            </MudText>
        </div>

        @if (_loadError != null)
        {
            <ErrorState Message="@_loadError" OnRetry="LoadSurfacesAsync" />
        }
        else if (_surfaces == null)
        {
            <EmptyState Message="No personal gym stats found yet. Import data first." />
        }
        else
        {
            var points = FilteredPoints;

            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Visible sample</MudText>
                            <MudText Typo="Typo.h5" data-testid="visible-sample-count">@points.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">of @_surfaces.Meta.GymPointCount plotted observations</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Average gain / energy</MudText>
                            <MudText Typo="Typo.h5">@AverageEfficiency(points)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Observed stat gain per energy spent</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Average happiness</MudText>
                            <MudText Typo="Typo.h5">@AverageHappiness(points)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Before the recorded train</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Date span</MudText>
                            <MudText Typo="Typo.subtitle1" data-testid="date-span">@DateRangeLabel(points)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">UTC, for the visible sample</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <MudCard>
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex-wrap:wrap">
                        <div style="min-width: 180px">
                            <MudText Typo="Typo.overline">Filter</MudText>
                            <select aria-label="Stat filter"
                                    value="@_statFilter"
                                    @onchange="OnStatFilterChangedAsync"
                                    style="display:block;width:100%;min-height:40px;padding:6px 10px;border-radius:4px">
                                <option value="all">All stats</option>
                                @foreach (var statType in AvailableStatTypes)
                                {
                                    <option value="@statType">@FormatStatType(statType)</option>
                                }
                            </select>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Dataset @_surfaces.Version · @_surfaces.Meta.RecordCount records processed · @points.Count observations in this view
                        </MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>

            <MudGrid>
                <MudItem xs="12" lg="6">
                    <MudCard Style="height:100%">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Gain / energy over time</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Each dot is one imported training observation.</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <div id="training-efficiency-time-chart" style="width:100%;height:360px"></div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" lg="6">
                    <MudCard Style="height:100%">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Gain / energy vs stat before</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Compare observed efficiency across your stat-size range.</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <div id="training-efficiency-stat-chart" style="width:100%;height:360px"></div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Gain / energy vs happiness</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">See the relationship in the raw observations without turning correlation into advice.</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <div id="training-efficiency-happy-chart" style="width:100%;height:360px"></div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }

        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Refresh training data</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Import your authenticated Torn gym history, then refresh these observations.
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudTextField @bind-Value="_apiKey"
                                  Label="Torn API Key"
                                  InputType="InputType.Password"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Key"
                                  Style="flex: 1;"
                                  Disabled="@_importing" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="RunImportAsync"
                               Disabled="@(_importing || string.IsNullOrWhiteSpace(_apiKey))">
                        @(_importing ? "Importing..." : "Import + Refresh")
                    </MudButton>
                </MudStack>

                @if (!string.IsNullOrEmpty(_importStatusMessage))
                {
                    <MudAlert Severity="@_importStatusSeverity" Dense="true">@_importStatusMessage</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </MudStack>
}

@code {
    private string? _apiKey;
    private bool _importing;
    private string? _importStatusMessage;
    private Severity _importStatusSeverity = Severity.Info;
    private bool _loading = true;
    private string? _loadError;
    private MyStatsDatasetDto? _surfaces;
    private bool _chartsDrawn;
    private string _statFilter = "all";

    private IReadOnlyList<TrainingPoint> AllPoints => BuildTrainingPoints();

    private IReadOnlyList<TrainingPoint> FilteredPoints => _statFilter == "all"
        ? AllPoints
        : AllPoints.Where(point => string.Equals(point.StatType, _statFilter, StringComparison.OrdinalIgnoreCase)).ToArray();

    private IReadOnlyList<string> AvailableStatTypes => AllPoints
        .Select(point => point.StatType)
        .Where(statType => !string.Equals(statType, "unknown", StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(statType => statType, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    protected override async Task OnInitializedAsync() => await LoadSurfacesAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_surfaces != null && !_chartsDrawn)
        {
            _chartsDrawn = true;
            await DrawChartsAsync();
        }
    }

    private async Task LoadSurfacesAsync()
    {
        _loading = true;
        _loadError = null;
        _chartsDrawn = false;

        try
        {
            _surfaces = await SurfacesApi.GetMyStatsAsync();
        }
        catch (ApiFailure failure) when (failure.Category == ApiFailureCategory.NotFound)
        {
            _surfaces = null;
        }
        catch (ApiFailure failure)
        {
            _surfaces = null;
            _loadError = BuildLoadFailureMessage(failure);
            Logger.LogError(failure,
                "Failed to load personal stats data. Endpoint={Endpoint} Status={StatusCode} Category={Category}",
                failure.Endpoint,
                failure.StatusCode is null ? null : (int)failure.StatusCode,
                failure.Category);
        }
        catch (Exception ex)
        {
            _surfaces = null;
            _loadError = "Failed to load personal stats data due to an unexpected error.";
            Logger.LogError(ex, "Failed to load personal stats data");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_apiKey))
        {
            _importStatusMessage = "Import requires a Torn API key.";
            _importStatusSeverity = Severity.Warning;
            return;
        }

        _importing = true;
        _importStatusMessage = "Queueing personal stats import...";
        _importStatusSeverity = Severity.Info;
        StateHasChanged();

        try
        {
            await SurfacesApi.StartMyStatsImportAsync(_apiKey.Trim(), fresh: true);
            _apiKey = null;
            _importStatusMessage = "Import queued — reloading personal stats...";
            _importStatusSeverity = Severity.Success;
            await LoadSurfacesAsync();
        }
        catch (ApiFailure failure)
        {
            _importStatusMessage = BuildImportFailureMessage(failure);
            _importStatusSeverity = Severity.Error;
            Logger.LogError(failure,
                "Personal stats import failed. Endpoint={Endpoint} Status={StatusCode} Category={Category}",
                failure.Endpoint,
                failure.StatusCode is null ? null : (int)failure.StatusCode,
                failure.Category);
        }
        catch (Exception ex)
        {
            _importStatusMessage = "Import failed due to an unexpected error.";
            _importStatusSeverity = Severity.Error;
            Logger.LogError(ex, "Personal stats import failed");
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task OnStatFilterChangedAsync(ChangeEventArgs args)
    {
        _statFilter = args.Value?.ToString() ?? "all";
        await DrawChartsAsync();
    }

    private async Task DrawChartsAsync()
    {
        if (_surfaces == null) return;

        var points = FilteredPoints;
        var timedPoints = points
            .Where(point => point.OccurredAtUtc.HasValue)
            .OrderBy(point => point.OccurredAtUtc)
            .ToArray();

        try
        {
            await JS.InvokeVoidAsync("plotlyInterop.render",
                "training-efficiency-time-chart",
                new[] { BuildTimeTrace(timedPoints) },
                BuildLayout("Date (UTC)", "Stat gain / energy"));

            await JS.InvokeVoidAsync("plotlyInterop.render",
                "training-efficiency-stat-chart",
                new[] { BuildStatTrace(points) },
                BuildLayout("Stat before train", "Stat gain / energy"));

            await JS.InvokeVoidAsync("plotlyInterop.render",
                "training-efficiency-happy-chart",
                new[] { BuildHappyTrace(points) },
                BuildLayout("Happiness before train", "Stat gain / energy"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to draw personal training charts");
        }
    }

    private IReadOnlyList<TrainingPoint> BuildTrainingPoints()
    {
        if (_surfaces == null)
            return Array.Empty<TrainingPoint>();

        var cloud = _surfaces.Series.GymCloud;
        var count = Math.Min(cloud.X.Length, Math.Min(cloud.Y.Length, cloud.Z.Length));
        var text = cloud.Text ?? Array.Empty<string>();
        var result = new TrainingPoint[count];

        for (var i = 0; i < count; i++)
        {
            var metadata = i < text.Length ? ParsePointMetadata(text[i]) : ("unknown", (DateTimeOffset?)null);
            result[i] = new TrainingPoint(cloud.X[i], cloud.Y[i], cloud.Z[i], metadata.Item1, metadata.Item2);
        }

        return result;
    }

    private static (string StatType, DateTimeOffset? OccurredAtUtc) ParsePointMetadata(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return ("unknown", null);

        var separator = text.IndexOf(' ');
        if (separator <= 0 || separator == text.Length - 1)
            return (text.Trim(), null);

        var statType = text[..separator].Trim();
        var timestampText = text[(separator + 1)..].Trim();
        var parsed = DateTimeOffset.TryParse(
            timestampText,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var occurredAtUtc);

        return (string.IsNullOrWhiteSpace(statType) ? "unknown" : statType, parsed ? occurredAtUtc : null);
    }

    private static string DateRangeLabel(IReadOnlyList<TrainingPoint> points)
    {
        var timestamps = points
            .Where(point => point.OccurredAtUtc.HasValue)
            .Select(point => point.OccurredAtUtc!.Value)
            .OrderBy(value => value)
            .ToArray();

        if (timestamps.Length == 0)
            return "Timestamp metadata unavailable";

        var start = timestamps[0].UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var end = timestamps[^1].UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return start == end ? start : $"{start} → {end}";
    }

    private static string AverageEfficiency(IReadOnlyList<TrainingPoint> points)
        => points.Count == 0
            ? "—"
            : points.Average(point => point.Efficiency).ToString("0.####", CultureInfo.InvariantCulture);

    private static string AverageHappiness(IReadOnlyList<TrainingPoint> points)
        => points.Count == 0
            ? "—"
            : points.Average(point => point.HappinessBefore).ToString("0", CultureInfo.InvariantCulture);

    private static string FormatStatType(string statType)
        => string.IsNullOrWhiteSpace(statType)
            ? "Unknown"
            : char.ToUpperInvariant(statType[0]) + statType[1..];

    private static object BuildTimeTrace(IReadOnlyList<TrainingPoint> points) => new
    {
        type = "scatter",
        mode = "markers",
        x = points.Select(point => point.OccurredAtUtc!.Value.ToString("O", CultureInfo.InvariantCulture)).ToArray(),
        y = points.Select(point => point.Efficiency).ToArray(),
        text = points.Select(point => FormatStatType(point.StatType)).ToArray(),
        hovertemplate = "%{text}<br>%{x}<br>Gain / energy: %{y}<extra></extra>",
        marker = new { size = 7, opacity = 0.82 }
    };

    private static object BuildStatTrace(IReadOnlyList<TrainingPoint> points) => new
    {
        type = "scatter",
        mode = "markers",
        x = points.Select(point => point.StatBefore).ToArray(),
        y = points.Select(point => point.Efficiency).ToArray(),
        text = points.Select(point => FormatStatType(point.StatType)).ToArray(),
        hovertemplate = "%{text}<br>Stat before: %{x}<br>Gain / energy: %{y}<extra></extra>",
        marker = new { size = 7, opacity = 0.82 }
    };

    private static object BuildHappyTrace(IReadOnlyList<TrainingPoint> points) => new
    {
        type = "scatter",
        mode = "markers",
        x = points.Select(point => point.HappinessBefore).ToArray(),
        y = points.Select(point => point.Efficiency).ToArray(),
        text = points.Select(point => FormatStatType(point.StatType)).ToArray(),
        hovertemplate = "%{text}<br>Happiness before: %{x}<br>Gain / energy: %{y}<extra></extra>",
        marker = new { size = 7, opacity = 0.82 }
    };

    private static object BuildLayout(string xTitle, string yTitle) => new
    {
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "rgba(0,0,0,0)",
        font = new { color = "#e8f1ff", family = "Roboto, sans-serif" },
        xaxis = new { title = xTitle, gridcolor = "#243457", zerolinecolor = "#243457" },
        yaxis = new { title = yTitle, gridcolor = "#243457", zerolinecolor = "#243457" },
        margin = new { l = 56, r = 18, t = 12, b = 52 }
    };

    private static string BuildLoadFailureMessage(ApiFailure failure) => failure.Category switch
    {
        ApiFailureCategory.ApiUnavailable => "Could not load your stats. The service is temporarily unavailable — try again shortly.",
        ApiFailureCategory.BadGateway => "Could not load your stats. The service is temporarily unavailable — try again shortly.",
        ApiFailureCategory.Validation => "Could not load your stats: request was rejected. Sign in again and verify account claims.",
        ApiFailureCategory.NotFound => "No personal gym stats found yet. Import data first.",
        ApiFailureCategory.Deserialization => "Could not load your stats: API response format was invalid.",
        _ => $"Could not load your stats: {failure.SafeMessage}"
    };

    private static string BuildImportFailureMessage(ApiFailure failure) => failure.Category switch
    {
        ApiFailureCategory.Unauthorized => "Import rejected: your session is not authenticated. Sign in again.",
        ApiFailureCategory.Forbidden => "Import rejected: your authenticated account does not match the requested owner.",
        ApiFailureCategory.IdentitySetupRequired => "Import blocked: connect your account identity map before importing personal stats.",
        ApiFailureCategory.Validation => "Import rejected: request validation failed.",
        ApiFailureCategory.BadGateway => "Import failed. The service is temporarily unavailable — try again shortly.",
        ApiFailureCategory.ApiUnavailable => "Import failed. The service is temporarily unavailable — try again shortly.",
        ApiFailureCategory.Deserialization => "Import failed: API response format was invalid.",
        ApiFailureCategory.ImportFailure => "Import failed. Please try again.",
        _ => $"Import failed: {failure.SafeMessage}"
    };

    private sealed record TrainingPoint(
        double StatBefore,
        double HappinessBefore,
        double Efficiency,
        string StatType,
        DateTimeOffset? OccurredAtUtc);
}
