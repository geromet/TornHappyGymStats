@page "/my-stats"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@inject SurfacesService SurfacesApi
@inject IJSRuntime JS
@inject ILogger<MyStats> Logger

<PageTitle>My stats · Happy Gym Stats</PageTitle>

<MudCard Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">My stats</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Your personal gym train point cloud for the account you're signed in with.
        </MudText>

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
            <MudTextField @bind-Value="_apiKey"
                          Label="Torn API Key"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Key"
                          Style="flex: 1;"
                          Disabled="@_importing" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RunImportAsync"
                       Disabled="@(_importing || string.IsNullOrWhiteSpace(_apiKey))">
                @(_importing ? "Importing..." : "Import + Refresh")
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrEmpty(_importStatusMessage))
        {
            <MudAlert Severity="@_importStatusSeverity" Dense="true">@_importStatusMessage</MudAlert>
        }
    </MudCardContent>
</MudCard>

@if (_loading)
{
    <LoadingState Message="Loading your stats…" />
}
else if (_loadError != null)
{
    <ErrorState Message="@_loadError" />
}
else if (_surfaces != null)
{
    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
                    <div>
                        <MudText Typo="Typo.h6">My gym trains point cloud</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @_surfaces.Meta.GymPointCount points
                        </MudText>
                    </div>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent Class="pa-0">
            <div id="my-gym-cloud-chart" style="width: 100%; height: 760px;"></div>
        </MudCardContent>
    </MudCard>
}

@code {
    private string? _apiKey;
    private bool _importing;
    private string? _importStatusMessage;
    private Severity _importStatusSeverity = Severity.Info;
    private bool _loading = true;
    private string? _loadError;
    private MyStatsDatasetDto? _surfaces;
    private bool _chartsDrawn;

    protected override async Task OnInitializedAsync() => await LoadSurfacesAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_surfaces != null && !_chartsDrawn)
        {
            _chartsDrawn = true;
            await DrawChartsAsync();
        }
    }

    private async Task LoadSurfacesAsync()
    {
        _loading = true;
        _loadError = null;
        _chartsDrawn = false;

        try
        {
            _surfaces = await SurfacesApi.GetMyStatsAsync();
            if (_surfaces == null)
                _loadError = "No personal gym stats found yet. Import data first.";
        }
        catch (ApiFailure failure)
        {
            _loadError = BuildLoadFailureMessage(failure);
            Logger.LogError(failure,
                "Failed to load personal stats data. Endpoint={Endpoint} Status={StatusCode} Category={Category}",
                failure.Endpoint,
                failure.StatusCode is null ? null : (int)failure.StatusCode,
                failure.Category);
        }
        catch (Exception ex)
        {
            _loadError = "Could not load your stats. Please try again.";
            Logger.LogError(ex, "Failed to load personal stats data");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RunImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_apiKey))
        {
            _importStatusMessage = "Import requires a Torn API key.";
            _importStatusSeverity = Severity.Warning;
            return;
        }

        _importing = true;
        _importStatusMessage = "Queueing personal stats import...";
        _importStatusSeverity = Severity.Info;
        StateHasChanged();

        try
        {
            await SurfacesApi.StartMyStatsImportAsync(_apiKey.Trim(), fresh: true);
            _apiKey = null;

            _importStatusMessage = "Import queued — reloading personal stats...";
            _importStatusSeverity = Severity.Success;

            await LoadSurfacesAsync();
        }
        catch (ApiFailure failure)
        {
            _importStatusMessage = BuildImportFailureMessage(failure);
            _importStatusSeverity = Severity.Error;
            Logger.LogError(failure,
                "Personal stats import failed. Endpoint={Endpoint} Status={StatusCode} Category={Category}",
                failure.Endpoint,
                failure.StatusCode is null ? null : (int)failure.StatusCode,
                failure.Category);
        }
        catch (Exception ex)
        {
            _importStatusMessage = "Import failed. Please try again.";
            _importStatusSeverity = Severity.Error;
            Logger.LogError(ex, "Personal stats import failed");
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task DrawChartsAsync()
    {
        if (_surfaces == null) return;
        try
        {
            await JS.InvokeVoidAsync("plotlyInterop.render",
                "my-gym-cloud-chart",
                new[] { BuildGymTrace(_surfaces.Series.GymCloud) },
                BuildLayout("Stat before train", "Happy before train", "Stat gained / energy"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to draw personal stats chart");
        }
    }

    private static object BuildGymTrace(GymCloudSeriesDto cloud) => new
    {
        type = "scatter3d",
        mode = "markers",
        x = cloud.X,
        y = cloud.Y,
        z = cloud.Z,
        hovertemplate = "Stat before: %{x}<br>Happy before: %{y}<br>Gain / energy: %{z}<extra></extra>",
        marker = new { size = 6, opacity = 0.88, color = "#58a6ff" }
    };

    private static object BuildLayout(string xTitle, string yTitle, string zTitle) => new
    {
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "rgba(0,0,0,0)",
        font = new { color = "#e8f1ff", family = "Roboto, sans-serif" },
        scene = new
        {
            aspectmode = "manual",
            aspectratio = new { x = 1.35, y = 1.35, z = 1.2 },
            xaxis = new { title = xTitle, gridcolor = "#243457", zerolinecolor = "#243457" },
            yaxis = new { title = yTitle, gridcolor = "#243457", zerolinecolor = "#243457" },
            zaxis = new { title = zTitle, gridcolor = "#243457", zerolinecolor = "#243457" },
            bgcolor = "rgba(0,0,0,0)"
        },
        margin = new { l = 0, r = 0, t = 0, b = 0 }
    };

    private static string BuildLoadFailureMessage(ApiFailure failure) => failure.Category switch
    {
        ApiFailureCategory.ApiUnavailable => "Could not load your stats. The service is temporarily unavailable — try again shortly.",
        ApiFailureCategory.BadGateway => "Could not load your stats. The service is temporarily unavailable — try again shortly.",
        ApiFailureCategory.Validation => "Could not load your stats. Sign in again and try again.",
        ApiFailureCategory.NotFound => "No personal gym stats found yet. Import data first.",
        _ => "Could not load your stats. Please try again."
    };

    private static string BuildImportFailureMessage(ApiFailure failure) => failure.Category switch
    {
        ApiFailureCategory.Unauthorized => "Import rejected. Sign in again and try again.",
        ApiFailureCategory.Forbidden => "Import rejected. Sign in with the account you want to import.",
        ApiFailureCategory.IdentitySetupRequired => "Import blocked. Connect your Torn account before importing personal stats.",
        ApiFailureCategory.Validation => "Import rejected. Check your Torn API key and try again.",
        ApiFailureCategory.BadGateway => "Import failed. The service is temporarily unavailable — try again shortly.",
        ApiFailureCategory.ApiUnavailable => "Import failed. The service is temporarily unavailable — try again shortly.",
        _ => "Import failed. Please try again."
    };
}
