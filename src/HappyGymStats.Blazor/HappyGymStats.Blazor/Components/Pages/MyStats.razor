@page "/my-stats"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@inject SurfacesService SurfacesApi
@inject IJSRuntime JS
@inject ILogger<MyStats> Logger

<PageTitle>My Training · Happy Gym Stats</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading your training data…" />
}
else
{
    <MudStack Spacing="3">
        <div>
            <MudText Typo="Typo.h4">My Training</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Review observations from the account you're signed in with. These charts describe imported training history; they do not prescribe a training strategy.
            </MudText>
        </div>

        @if (_loadError is not null)
        {
            <ErrorState Message="@_loadError" OnRetry="LoadSurfacesAsync" />
        }
        else if (_surfaces is null)
        {
            <EmptyState Message="No personal gym stats found yet." />
            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Connect your training data</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Add or refresh your Torn connection in Account &amp; Connections, then reload this page. Raw API keys stay out of My Training.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Href="/player-account" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link">
                            Account &amp; Connections
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadSurfacesAsync">
                            Refresh
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
        else
        {
            var points = FilteredPoints;

            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Visible sample</MudText>
                            <MudText Typo="Typo.h5" data-testid="visible-sample-count">@points.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">of @_surfaces.Meta.GymPointCount plotted observations</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Average gain / energy</MudText>
                            <MudText Typo="Typo.h5">@AverageEfficiency(points)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Observed stat gain per energy spent</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Average happiness</MudText>
                            <MudText Typo="Typo.h5">@AverageHappiness(points)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Before the recorded train</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Style="height:100%">
                        <MudCardContent>
                            <MudText Typo="Typo.overline">Date span</MudText>
                            <MudText Typo="Typo.subtitle1" data-testid="date-span">@DateRangeLabel(points)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">UTC, for the visible sample</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="flex-wrap">
                    <div style="min-width: 180px">
                        <MudText Typo="Typo.overline">Filter</MudText>
                        <select aria-label="Stat filter"
                                value="@_statFilter"
                                @onchange="OnStatFilterChangedAsync"
                                style="display:block;width:100%;min-height:40px;padding:6px 10px;border-radius:4px">
                            <option value="all">All stats</option>
                            @foreach (var statType in AvailableStatTypes)
                            {
                                <option value="@statType">@FormatStatType(statType)</option>
                            }
                        </select>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Dataset @_surfaces.Version · @_surfaces.Meta.RecordCount records processed · @points.Count observations in this view
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudGrid>
                <MudItem xs="12" lg="6">
                    <MudCard Style="height:100%">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Gain / energy over time</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Each dot is one imported training observation.</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <div id="training-efficiency-time-chart" style="width:100%;height:360px"></div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" lg="6">
                    <MudCard Style="height:100%">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Gain / energy vs stat before</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Compare observed efficiency across your stat-size range.</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <div id="training-efficiency-stat-chart" style="width:100%;height:360px"></div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12">
                    <MudCard>
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Gain / energy vs happiness</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">See the relationship in the raw observations without turning correlation into advice.</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pa-0">
                            <div id="training-efficiency-happy-chart" style="width:100%;height:360px"></div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2" Class="flex-wrap">
                    <div>
                        <MudText Typo="Typo.h6">Refresh training data</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Connection setup belongs in Account &amp; Connections; My Training only reads the data associated with your signed-in account.
                        </MudText>
                    </div>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Href="/player-account" Variant="Variant.Text">Manage connection</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadSurfacesAsync">Refresh</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {
    private bool _loading = true;
    private string? _loadError;
    private MyStatsDatasetDto? _surfaces;
    private bool _chartsDrawn;
    private string _statFilter = "all";

    private IReadOnlyList<TrainingPoint> AllPoints => BuildTrainingPoints();

    private IReadOnlyList<TrainingPoint> FilteredPoints => _statFilter == "all"
        ? AllPoints
        : AllPoints.Where(point => string.Equals(point.StatType, _statFilter, StringComparison.OrdinalIgnoreCase)).ToArray();

    private IReadOnlyList<string> AvailableStatTypes => AllPoints
        .Select(point => point.StatType)
        .Where(statType => !string.Equals(statType, "unknown", StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(statType => statType, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    protected override Task OnInitializedAsync() => LoadSurfacesAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_surfaces is not null && !_chartsDrawn)
        {
            _chartsDrawn = true;
            await DrawChartsAsync();
        }
    }

    private async Task LoadSurfacesAsync()
    {
        _loading = true;
        _loadError = null;
        _chartsDrawn = false;

        try
        {
            _surfaces = await SurfacesApi.GetMyStatsAsync();
        }
        catch (ApiFailure failure) when (failure.Category == ApiFailureCategory.NotFound)
        {
            _surfaces = null;
        }
        catch (ApiFailure failure)
        {
            _surfaces = null;
            _loadError = "Could not load your stats. Please try again.";
            Logger.LogError(failure,
                "Failed to load personal stats data. Endpoint={Endpoint} Status={StatusCode} Category={Category}",
                failure.Endpoint,
                failure.StatusCode is null ? null : (int)failure.StatusCode,
                failure.Category);
        }
        catch (Exception ex)
        {
            _surfaces = null;
            _loadError = "Could not load your stats. Please try again.";
            Logger.LogError(ex, "Failed to load personal stats data");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStatFilterChangedAsync(ChangeEventArgs args)
    {
        _statFilter = args.Value?.ToString() ?? "all";
        await DrawChartsAsync();
    }

    private async Task DrawChartsAsync()
    {
        if (_surfaces is null)
        {
            return;
        }

        var points = FilteredPoints;
        var timedPoints = points
            .Where(point => point.OccurredAtUtc.HasValue)
            .OrderBy(point => point.OccurredAtUtc)
            .ToArray();

        try
        {
            await JS.InvokeVoidAsync(
                "plotlyInterop.render",
                "training-efficiency-time-chart",
                new[] { BuildTimeTrace(timedPoints) },
                BuildLayout("Date (UTC)", "Stat gain / energy"));
            await JS.InvokeVoidAsync(
                "plotlyInterop.render",
                "training-efficiency-stat-chart",
                new[] { BuildStatTrace(points) },
                BuildLayout("Stat before train", "Stat gain / energy"));
            await JS.InvokeVoidAsync(
                "plotlyInterop.render",
                "training-efficiency-happy-chart",
                new[] { BuildHappyTrace(points) },
                BuildLayout("Happiness before train", "Stat gain / energy"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to draw personal training charts");
        }
    }

    private IReadOnlyList<TrainingPoint> BuildTrainingPoints()
    {
        if (_surfaces is null)
        {
            return Array.Empty<TrainingPoint>();
        }

        var cloud = _surfaces.Series.GymCloud;
        var count = Math.Min(cloud.X.Length, Math.Min(cloud.Y.Length, cloud.Z.Length));
        var text = cloud.Text ?? Array.Empty<string>();
        var result = new TrainingPoint[count];

        for (var i = 0; i < count; i++)
        {
            var (statType, occurredAtUtc) = i < text.Length
                ? ParsePointMetadata(text[i])
                : ("unknown", (DateTimeOffset?)null);
            result[i] = new TrainingPoint(
                cloud.X[i],
                cloud.Y[i],
                cloud.Z[i],
                statType,
                occurredAtUtc);
        }

        return result;
    }

    private static (string StatType, DateTimeOffset? OccurredAtUtc) ParsePointMetadata(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return ("unknown", null);
        }

        var separator = text.IndexOf(' ');
        if (separator <= 0 || separator == text.Length - 1)
        {
            return (text.Trim(), null);
        }

        var statType = text[..separator].Trim();
        var timestampText = text[(separator + 1)..].Trim();
        var parsed = DateTimeOffset.TryParse(
            timestampText,
            CultureInfo.InvariantCulture,
            DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
            out var occurredAtUtc);

        return (string.IsNullOrWhiteSpace(statType) ? "unknown" : statType, parsed ? occurredAtUtc : null);
    }

    private static string DateRangeLabel(IReadOnlyList<TrainingPoint> points)
    {
        var timestamps = points
            .Where(point => point.OccurredAtUtc.HasValue)
            .Select(point => point.OccurredAtUtc!.Value)
            .OrderBy(value => value)
            .ToArray();

        if (timestamps.Length == 0)
        {
            return "Timestamp metadata unavailable";
        }

        var start = timestamps[0].UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        var end = timestamps[^1].UtcDateTime.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return start == end ? start : $"{start} → {end}";
    }

    private static string AverageEfficiency(IReadOnlyList<TrainingPoint> points)
        => points.Count == 0
            ? "—"
            : points.Average(point => point.Efficiency).ToString("0.####", CultureInfo.InvariantCulture);

    private static string AverageHappiness(IReadOnlyList<TrainingPoint> points)
        => points.Count == 0
            ? "—"
            : points.Average(point => point.HappinessBefore).ToString("0", CultureInfo.InvariantCulture);

    private static string FormatStatType(string statType)
        => string.IsNullOrWhiteSpace(statType)
            ? "Unknown"
            : char.ToUpperInvariant(statType[0]) + statType[1..];

    private static object BuildTimeTrace(IReadOnlyList<TrainingPoint> points) => new
    {
        type = "scatter",
        mode = "markers",
        x = points.Select(point => point.OccurredAtUtc!.Value.UtcDateTime.ToString("O", CultureInfo.InvariantCulture)).ToArray(),
        y = points.Select(point => point.Efficiency).ToArray(),
        text = points.Select(point => FormatStatType(point.StatType)).ToArray(),
        hovertemplate = "%{text}<br>%{x}<br>gain/energy %{y:.4f}<extra></extra>"
    };

    private static object BuildStatTrace(IReadOnlyList<TrainingPoint> points) => new
    {
        type = "scatter",
        mode = "markers",
        x = points.Select(point => point.StatBefore).ToArray(),
        y = points.Select(point => point.Efficiency).ToArray(),
        text = points.Select(point => FormatStatType(point.StatType)).ToArray(),
        hovertemplate = "%{text}<br>stat %{x:,.0f}<br>gain/energy %{y:.4f}<extra></extra>"
    };

    private static object BuildHappyTrace(IReadOnlyList<TrainingPoint> points) => new
    {
        type = "scatter",
        mode = "markers",
        x = points.Select(point => point.HappinessBefore).ToArray(),
        y = points.Select(point => point.Efficiency).ToArray(),
        text = points.Select(point => FormatStatType(point.StatType)).ToArray(),
        hovertemplate = "%{text}<br>happiness %{x:,.0f}<br>gain/energy %{y:.4f}<extra></extra>"
    };

    private static object BuildLayout(string xTitle, string yTitle) => new
    {
        margin = new { l = 64, r = 24, t = 20, b = 56 },
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "rgba(0,0,0,0)",
        xaxis = new { title = xTitle, automargin = true },
        yaxis = new { title = yTitle, automargin = true }
    };

    private sealed record TrainingPoint(
        double StatBefore,
        double HappinessBefore,
        double Efficiency,
        string StatType,
        DateTimeOffset? OccurredAtUtc);
}
