@page "/Error"
@using System.Diagnostics

<PageTitle>Something went wrong · Happy Gym Stats</PageTitle>

<MudCard Class="mx-auto mt-6" Style="max-width:600px;">
    <MudCardContent>
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.h5">Something went wrong</MudText>
            </MudStack>

            <MudText Typo="Typo.body1" Color="Color.Secondary">
                An unexpected error occurred. Try refreshing the page or go back to home.
            </MudText>

            @if (ShowRequestId)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Request ID: <code>@RequestId</code>
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Home"
                       Href="/">
                Go to home
            </MudButton>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
