[Unit]
Description=HappyGymStats API backend (dev host — torndev.geromet.com)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/happygymstats-dev/current
ExecStart=/var/www/happygymstats-dev/current/HappyGymStats.Api
Restart=on-failure
RestartSec=5

# Runtime contract source (secrets are server-local; never committed):
# /etc/happygymstats/api-dev.env must define:
# - ConnectionStrings__HappyGymStats  MUST point at a database separate from
#   production. The API runs migrations at startup, so a shared connection
#   string would let a dev build mutate the production schema.
# - ProvisionalToken__SigningKey      MUST differ from production, otherwise
#   tokens minted here are accepted by the production API.
# - HAPPYGYMSTATS_SURFACES_CACHE_DIR  should point under /var/www/happygymstats-dev.
EnvironmentFile=/etc/happygymstats/api-dev.env

# Non-secret service defaults. These follow EnvironmentFile= deliberately:
# systemd applies the directives in order, so a stale value left in the env
# file cannot override them.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5147

# Dev-only token audience. Requires a Keycloak client 'happygymstats-api-dev'
# and an audience mapper on 'happygymstats-web-dev' pointing at it. Without
# this the dev and production APIs accept the same tokens, so a dev session's
# access token is replayable against production.
Environment=Keycloak__Audience=happygymstats-api-dev

[Install]
WantedBy=multi-user.target
