[Unit]
Description=HappyGymStats Blazor frontend (dev host — torndev.geromet.com)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/happygymstats-blazor-dev/current
ExecStart=/var/www/happygymstats-blazor-dev/current/HappyGymStats.Blazor
Restart=on-failure
RestartSec=5

# Runtime secrets (server-local, never committed). Must define:
# - Keycloak__ClientSecret   the credential of 'happygymstats-web-dev'. MUST
#                            differ from production's; they are different
#                            Keycloak clients and the secrets are not shared.
# Deliberately NOT /etc/happygymstats/blazor.env: sourcing production's file
# would hand the dev host the production client credential.
EnvironmentFile=/etc/happygymstats/blazor-dev.env

# Non-secret defaults, after EnvironmentFile= so they cannot be overridden.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5282

# MUST be the dev API (5147), not production's 5047. Pointing this at 5047
# would make the dev frontend drive the production API and its database while
# looking like an isolated environment.
Environment=ApiBaseUrl=http://127.0.0.1:5147

# Whole-site admin gate. Only this host sets it; production leaves it unset and
# is therefore unaffected. See RestrictedAccessExtensions.
Environment=Access__RestrictToAdmins=true

# Dedicated Keycloak client so a production session cookie cannot ride into dev.
Environment=Keycloak__ClientId=happygymstats-web-dev
Environment=Keycloak__RequireClientSecret=true

# Data-protection key ring. systemd creates /var/lib/happygymstats-blazor-dev as 0700
# www-data and keeps it across restarts and deploys; the framework default
# would put the keys under a path the release-symlink swap replaces, so every
# deploy would invalidate every auth cookie. Keys are unencrypted at rest —
# on Linux the only built-in encryptor is an X.509 cert, and the 0700
# directory is the protection here. That is what the "No XML encryptor
# configured" warning at startup refers to.
StateDirectory=happygymstats-blazor-dev
StateDirectoryMode=0700
Environment=DataProtection__KeyRingPath=/var/lib/happygymstats-blazor-dev
Environment=DataProtection__ApplicationName=HappyGymStats.Blazor.Dev

[Install]
WantedBy=multi-user.target
