[Unit]
Description=HappyGymStats Blazor frontend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/happygymstats-blazor/current
ExecStart=/var/www/happygymstats-blazor/current/HappyGymStats.Blazor
Restart=on-failure
RestartSec=5

# Runtime secrets (server-local, never committed). Must define:
# - Keycloak__ClientSecret   the credential of the confidential Keycloak client
#                            'happygymstats-web'. Unit files are world-readable
#                            (0644), so this may never be an Environment= line.
# The file is 0640 root:www-data; the service fails to start without it.
EnvironmentFile=/etc/happygymstats/blazor.env

# Non-secret defaults, after EnvironmentFile= so they cannot be overridden.
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5182
Environment=ApiBaseUrl=http://127.0.0.1:5047

# Confidential client: refuse to start without a secret rather than silently
# falling back to a public client and failing later at the token exchange.
Environment=Keycloak__RequireClientSecret=true

[Install]
WantedBy=multi-user.target
