# Copy to .env and fill in values. Never commit .env to git.

# PostgreSQL — app database user
POSTGRES_PASSWORD=

# PostgreSQL — Keycloak's database user (separate DB, same Postgres instance)
KEYCLOAK_DB_PASSWORD=

# Keycloak admin console credentials
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# WarPoller -> API loopback hub notification (optional)
# Keep this on a private loopback/base-network route; do not commit real notify secrets.
WarPoller__HubNotifyUrl=http://happygymstats-api:8080/api/v1/war/internal/notify
WarPoller__HubNotifyTimeoutSeconds=5
