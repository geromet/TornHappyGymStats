<Project>

  <!--
    Shared compiler and analyzer policy.

    The solution has an established zero-warning baseline in canonical CI. Keep
    warnings mechanically blocking here so a newly introduced compiler or .NET
    analyzer warning fails every project consistently instead of relying on a
    project-by-project setting or log inspection.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Normalises embedded paths on a CI runner so builds are reproducible.
         Off locally, where absolute paths make debugging easier. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
